  Unicode normalization (UAX #15): NFC, NFD, NFKC and NFKD. The data is
  Unicode 15.0.0 (LandrixXmlNormalizeData.inc, generated by
  tools/gen-normalize-tables.py), the version of JDK 21's
  java.text.Normalizer that Saxon HE 12 calls for fn:normalize-unicode.
  The general categories of LandrixXmlUnicode stay at Unicode 6.2.0 on
  purpose (Saxon's regex tables). }

unit LandrixXmlNormalize;

{$I LandrixXml.inc}

interface

uses
  SysUtils,
  LandrixXmlBase,
  LandrixXmlUnicode;

type
  TLandrixXmlNormalizationForm = (xnfNfc, xnfNfd, xnfNfkc, xnfNfkd);

{ CodePoints in normalization form Form (a new array). Code points that
  are not assigned pass through unchanged. }
function LandrixXmlNormalizeCodePoints(const CodePoints: TLandrixXmlCodePoints;
  Form: TLandrixXmlNormalizationForm): TLandrixXmlCodePoints;
{ S (strictly valid UTF-8, else ELandrixXmlError xecInvalidUnicode) in
  normalization form Form; S itself when it is already normalized. }
function LandrixXmlNormalizeUtf8(const S: TLandrixXmlUtf8;
  Form: TLandrixXmlNormalizationForm): TLandrixXmlUtf8;

implementation

{$I LandrixXmlNormalizeData.inc}

const
  { quick check flags of NormQcFlags (same values as the generator) }
  NormQcNfdNo = 1;
  NormQcNfcNo = 2;
  NormQcNfcMaybe = 4;
  NormQcNfkdNo = 8;
  NormQcNfkcNo = 16;
  NormQcNfkcMaybe = 32;

  HangulSBase = $AC00;
  HangulLBase = $1100;
  HangulVBase = $1161;
  HangulTBase = $11A7;
  HangulLCount = 19;
  HangulVCount = 21;
  HangulTCount = 28;
  HangulNCount = HangulVCount * HangulTCount;
  HangulSCount = HangulLCount * HangulNCount;

  { runs of non-starters up to this length are sorted by insertion }
  ShortRun = 16;

function CombiningClass(CodePoint: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := 0;
  Lo := 0;
  Hi := NormCccCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CodePoint < NormCccLo[Mid] then
      Hi := Mid - 1
    else if CodePoint > NormCccHi[Mid] then
      Lo := Mid + 1
    else
    begin
      Result := NormCccValue[Mid];
      Exit;
    end;
  end;
end;

function QuickCheckFlags(CodePoint: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := 0;
  Lo := 0;
  Hi := NormQcCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CodePoint < NormQcLo[Mid] then
      Hi := Mid - 1
    else if CodePoint > NormQcHi[Mid] then
      Lo := Mid + 1
    else
    begin
      Result := NormQcFlags[Mid];
      Exit;
    end;
  end;
end;

{ Index of CodePoint in NormDecompKey, -1 if it has no decomposition. }
function DecompIndex(CodePoint: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := -1;
  Lo := 0;
  Hi := NormDecompCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CodePoint < NormDecompKey[Mid] then
      Hi := Mid - 1
    else if CodePoint > NormDecompKey[Mid] then
      Lo := Mid + 1
    else
    begin
      Result := Mid;
      Exit;
    end;
  end;
end;

{ The primary composite of First and Second, or -1. }
function Composite(First, Second: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := -1;
  if (First >= HangulLBase) and (First < HangulLBase + HangulLCount) and
    (Second >= HangulVBase) and (Second < HangulVBase + HangulVCount) then
  begin
    Result := HangulSBase + ((First - HangulLBase) * HangulVCount + Second - HangulVBase) * HangulTCount;
    Exit;
  end;
  if (First >= HangulSBase) and (First < HangulSBase + HangulSCount) and
    ((First - HangulSBase) mod HangulTCount = 0) and
    (Second > HangulTBase) and (Second < HangulTBase + HangulTCount) then
  begin
    Result := First + Second - HangulTBase;
    Exit;
  end;
  Lo := 0;
  Hi := NormPairCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if (First < NormPairFirst[Mid]) or ((First = NormPairFirst[Mid]) and (Second < NormPairSecond[Mid])) then
      Hi := Mid - 1
    else if (First > NormPairFirst[Mid]) or (Second > NormPairSecond[Mid]) then
      Lo := Mid + 1
    else
    begin
      Result := NormPairComposite[Mid];
      Exit;
    end;
  end;
end;

{ True if CodePoints is in form Form by the quick check (a "maybe" counts
  as not normalized). }
function QuickCheck(const CodePoints: TLandrixXmlCodePoints;
  Form: TLandrixXmlNormalizationForm): Boolean;
var
  I, C, Ccc, LastCcc, Mask: Integer;
begin
  case Form of
    xnfNfc: Mask := NormQcNfcNo or NormQcNfcMaybe;
    xnfNfd: Mask := NormQcNfdNo;
    xnfNfkc: Mask := NormQcNfkcNo or NormQcNfkcMaybe;
  else
    Mask := NormQcNfkdNo;
  end;
  Result := False;
  LastCcc := 0;
  for I := 0 to Integer(Length(CodePoints)) - 1 do
  begin
    C := CodePoints[I];
    { nothing below U+00A0 decomposes, no combining class below U+0300 }
    if C < $A0 then
      LastCcc := 0
    else
    begin
      Ccc := 0;
      if C >= $300 then
        Ccc := CombiningClass(C);
      if (Ccc <> 0) and (LastCcc > Ccc) then
        Exit;
      if QuickCheckFlags(C) and Mask <> 0 then
        Exit;
      LastCcc := Ccc;
    end;
  end;
  Result := True;
end;

{ Sorts Points[Lo..Hi - 1] stably by the combining classes Classes. }
procedure SortRun(var Points, Classes: TLandrixXmlCodePoints; Lo, Hi: Integer);
var
  I, J, P, C, K: Integer;
  Counts: array[0..255] of Integer;
  SortedPoints, SortedClasses: TLandrixXmlCodePoints;
begin
  if Hi - Lo <= ShortRun then
  begin
    for I := Lo + 1 to Hi - 1 do
    begin
      P := Points[I];
      C := Classes[I];
      J := I - 1;
      while (J >= Lo) and (Classes[J] > C) do
      begin
        Points[J + 1] := Points[J];
        Classes[J + 1] := Classes[J];
        Dec(J);
      end;
      Points[J + 1] := P;
      Classes[J + 1] := C;
    end;
    Exit;
  end;
  { a long run: counting sort, linear in its length }
  SortedPoints := nil;
  SortedClasses := nil;
  for K := 0 to 255 do
    Counts[K] := 0;
  for I := Lo to Hi - 1 do
    Inc(Counts[Classes[I]]);
  P := 0;
  for K := 0 to 255 do
  begin
    C := Counts[K];
    Counts[K] := P;
    Inc(P, C);
  end;
  SetLength(SortedPoints, Hi - Lo);
  SetLength(SortedClasses, Hi - Lo);
  for I := Lo to Hi - 1 do
  begin
    K := Classes[I];
    SortedPoints[Counts[K]] := Points[I];
    SortedClasses[Counts[K]] := K;
    Inc(Counts[K]);
  end;
  for I := Lo to Hi - 1 do
  begin
    Points[I] := SortedPoints[I - Lo];
    Classes[I] := SortedClasses[I - Lo];
  end;
end;

{ CodePoints decomposed, reordered and (NFC, NFKC) composed. }
function Normalize(const CodePoints: TLandrixXmlCodePoints;
  Form: TLandrixXmlNormalizationForm): TLandrixXmlCodePoints;
var
  Points, Classes: TLandrixXmlCodePoints;
  I, J, N, C, D, Start, Len, Count, Capacity, StarterPos, LastCcc, Ccc, Comp: Integer;
  Compatible: Boolean;

  procedure Append(CodePoint: Integer);
  begin
    if N >= Capacity then
    begin
      Capacity := Capacity * 2 + 16;
      SetLength(Points, Capacity);
    end;
    Points[N] := CodePoint;
    Inc(N);
  end;

begin
  Result := nil;
  Points := nil;
  Classes := nil;
  Count := Integer(Length(CodePoints));
  Compatible := Form in [xnfNfkc, xnfNfkd];
  { decomposition }
  Capacity := Count + Count div 2 + 16;
  SetLength(Points, Capacity);
  N := 0;
  for I := 0 to Count - 1 do
  begin
    C := CodePoints[I];
    if (C >= HangulSBase) and (C < HangulSBase + HangulSCount) then
    begin
      D := C - HangulSBase;
      Append(HangulLBase + D div HangulNCount);
      Append(HangulVBase + (D mod HangulNCount) div HangulTCount);
      if D mod HangulTCount <> 0 then
        Append(HangulTBase + D mod HangulTCount);
    end
    else
    begin
      D := -1;
      if C >= $A0 then
        D := DecompIndex(C);
      Len := 0;
      Start := 0;
      if D >= 0 then
        if Compatible then
        begin
          Start := NormCompatStart[D];
          Len := NormCompatLen[D];
        end
        else
        begin
          Start := NormCanonStart[D];
          Len := NormCanonLen[D];
        end;
      if Len = 0 then
        Append(C)
      else
        for J := Start to Start + Len - 1 do
          Append(NormPool[J]);
    end;
  end;
  { canonical ordering of each run of non-starters }
  SetLength(Classes, N);
  for I := 0 to N - 1 do
    if Points[I] >= $300 then
      Classes[I] := CombiningClass(Points[I])
    else
      Classes[I] := 0;
  I := 0;
  while I < N do
  begin
    if Classes[I] = 0 then
      Inc(I)
    else
    begin
      J := I + 1;
      while (J < N) and (Classes[J] <> 0) do
        Inc(J);
      if J - I > 1 then
        SortRun(Points, Classes, I, J);
      I := J;
    end;
  end;
  { composition: a character combines with the last starter unless a
    character between them has class 0 or a class not below its own }
  if Form in [xnfNfc, xnfNfkc] then
  begin
    StarterPos := -1;
    LastCcc := 0;
    J := 0;
    for I := 0 to N - 1 do
    begin
      C := Points[I];
      Ccc := Classes[I];
      Comp := -1;
      if (StarterPos >= 0) and ((J - 1 = StarterPos) or ((LastCcc <> 0) and (LastCcc < Ccc))) then
        Comp := Composite(Points[StarterPos], C);
      if Comp >= 0 then
        Points[StarterPos] := Comp
      else
      begin
        if Ccc = 0 then
          StarterPos := J;
        LastCcc := Ccc;
        Points[J] := C;
        Inc(J);
      end;
    end;
    N := J;
  end;
  SetLength(Points, N);
  Result := Points;
end;

function LandrixXmlNormalizeCodePoints(const CodePoints: TLandrixXmlCodePoints;
  Form: TLandrixXmlNormalizationForm): TLandrixXmlCodePoints;
begin
  if QuickCheck(CodePoints, Form) then
    Result := Copy(CodePoints, 0, Integer(Length(CodePoints)))
  else
    Result := Normalize(CodePoints, Form);
end;

function LandrixXmlNormalizeUtf8(const S: TLandrixXmlUtf8;
  Form: TLandrixXmlNormalizationForm): TLandrixXmlUtf8;
var
  I: Integer;
  CodePoints, Normalized: TLandrixXmlCodePoints;
begin
  Result := S;
  CodePoints := nil;
  Normalized := nil;
  I := 1;
  while (I <= Length(S)) and (Ord(S[I]) < $80) do
    Inc(I);
  if I > Length(S) then
    Exit;
  CodePoints := LandrixXmlUtf8ToCodePoints(S);
  if QuickCheck(CodePoints, Form) then
    Exit;
  Normalized := Normalize(CodePoints, Form);
  Result := LandrixXmlCodePointsToUtf8(Normalized, 0, Integer(Length(Normalized)));
end;

end.
