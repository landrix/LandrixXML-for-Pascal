  Unicode general categories and code point strings for the validation
  units. The category data is Unicode 6.2.0 (LandrixXmlUnicodeData.inc,
  generated by tools/gen-unicode-tables.py), the version Saxon HE 12 uses
  for regular expressions. }

unit LandrixXmlUnicode;

{$I LandrixXml.inc}

interface

uses
  SysUtils,
  LandrixXmlBase;

type
  { Same order as CATEGORIES in tools/gen-unicode-tables.py. }
  TLandrixXmlUnicodeCategory = (
    xucCn, xucCc, xucCf, xucCo, xucCs,
    xucLl, xucLm, xucLo, xucLt, xucLu,
    xucMc, xucMe, xucMn,
    xucNd, xucNl, xucNo,
    xucPc, xucPd, xucPe, xucPf, xucPi, xucPo, xucPs,
    xucSc, xucSk, xucSm, xucSo,
    xucZl, xucZp, xucZs
  );
  TLandrixXmlUnicodeCategories = set of TLandrixXmlUnicodeCategory;

  { A string as Unicode code points. }
  TLandrixXmlCodePoints = array of Integer;

const
  LandrixXmlCategoriesL = [xucLl, xucLm, xucLo, xucLt, xucLu];
  LandrixXmlCategoriesM = [xucMc, xucMe, xucMn];
  LandrixXmlCategoriesN = [xucNd, xucNl, xucNo];
  LandrixXmlCategoriesP = [xucPc, xucPd, xucPe, xucPf, xucPi, xucPo, xucPs];
  LandrixXmlCategoriesS = [xucSc, xucSk, xucSm, xucSo];
  LandrixXmlCategoriesZ = [xucZl, xucZp, xucZs];
  LandrixXmlCategoriesC = [xucCn, xucCc, xucCf, xucCo, xucCs];

function LandrixXmlUnicodeCategory(CodePoint: Integer): TLandrixXmlUnicodeCategory;

{ Number of ranges of the category table and range I (0-based); used to
  build character classes. }
function LandrixXmlUnicodeRangeCount: Integer;
procedure LandrixXmlUnicodeRange(I: Integer; out Lo, Hi: Integer;
  out Category: TLandrixXmlUnicodeCategory);

{ Strictly valid UTF-8 -> code points; raises ELandrixXmlError
  (xecInvalidUnicode) with the byte offset of a malformed sequence. }
function LandrixXmlUtf8ToCodePoints(const S: TLandrixXmlUtf8): TLandrixXmlCodePoints;
{ Code points Lo .. Hi - 1 (0-based, Hi exclusive) as UTF-8. }
function LandrixXmlCodePointsToUtf8(const CodePoints: TLandrixXmlCodePoints;
  Lo, Hi: Integer): TLandrixXmlUtf8;

implementation

{$I LandrixXmlUnicodeData.inc}

function LandrixXmlUnicodeCategory(CodePoint: Integer): TLandrixXmlUnicodeCategory;
var
  Lo, Hi, Mid: Integer;
begin
  Result := xucCn;
  Lo := 0;
  Hi := UnicodeRangeCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CodePoint < UnicodeRangeLo[Mid] then
      Hi := Mid - 1
    else if CodePoint > UnicodeRangeHi[Mid] then
      Lo := Mid + 1
    else
    begin
      Result := TLandrixXmlUnicodeCategory(UnicodeRangeCategory[Mid]);
      Exit;
    end;
  end;
end;

function LandrixXmlUnicodeRangeCount: Integer;
begin
  Result := UnicodeRangeCount;
end;

procedure LandrixXmlUnicodeRange(I: Integer; out Lo, Hi: Integer;
  out Category: TLandrixXmlUnicodeCategory);
begin
  Lo := UnicodeRangeLo[I];
  Hi := UnicodeRangeHi[I];
  Category := TLandrixXmlUnicodeCategory(UnicodeRangeCategory[I]);
end;

function LandrixXmlUtf8ToCodePoints(const S: TLandrixXmlUtf8): TLandrixXmlCodePoints;
var
  P: PAnsiChar;
  Pos, Len, N, Used: Integer;
  CodePoint: Cardinal;
begin
  Result := nil;
  Len := Length(S);
  SetLength(Result, Len);
  P := PAnsiChar(S);
  Pos := 0;
  N := 0;
  while Pos < Len do
  begin
    if Ord(P[Pos]) < $80 then
    begin
      Result[N] := Ord(P[Pos]);
      Inc(Pos);
    end
    else
    begin
      Used := LandrixXmlDecodeUtf8(P + Pos, Len - Pos, CodePoint);
      if Used = 0 then
        raise ELandrixXmlError.CreateAt(xecInvalidUnicode, 'Invalid UTF-8 byte sequence', 0, 0, Pos);
      Result[N] := Integer(CodePoint);
      Inc(Pos, Used);
    end;
    Inc(N);
  end;
  SetLength(Result, N);
end;

function LandrixXmlCodePointsToUtf8(const CodePoints: TLandrixXmlCodePoints;
  Lo, Hi: Integer): TLandrixXmlUtf8;
var
  Buffer: TLandrixXmlBuffer;
  I: Integer;
begin
  Buffer := TLandrixXmlBuffer.Create;
  try
    for I := Lo to Hi - 1 do
      Buffer.AppendCodePoint(Cardinal(CodePoints[I]));
    Result := Buffer.AsUtf8;
  finally
    Buffer.Free;
  end;
end;

end.
