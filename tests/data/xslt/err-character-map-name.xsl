<?xml version="1.0" encoding="UTF-8"?>
<!-- XTSE0020: use-character-maps with a name that is not a QName. -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output use-character-maps="1a"/>
  <xsl:template match="/">
    <out>a</out>
  </xsl:template>
</xsl:stylesheet>
