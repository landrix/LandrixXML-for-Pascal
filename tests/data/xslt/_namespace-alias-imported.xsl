<?xml version="1.0" encoding="UTF-8"?>
<!-- Imported by namespace-alias.xsl: an alias of lower precedence and a
     template whose literal result element the importing module's alias
     changes. -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:a="urn:alias" xmlns:low="urn:low">
  <xsl:namespace-alias stylesheet-prefix="a" result-prefix="low"/>
  <xsl:template name="imported">
    <a:imported/>
  </xsl:template>
</xsl:stylesheet>
