<?xml version="1.0" encoding="UTF-8"?>
<!-- XTDE0440: a default namespace for an element in no namespace. -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/">
    <out><xsl:namespace name="">urn:a</xsl:namespace></out>
  </xsl:template>
</xsl:stylesheet>
