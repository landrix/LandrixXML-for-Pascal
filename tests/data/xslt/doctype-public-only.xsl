<?xml version="1.0" encoding="UTF-8"?>
<!-- method xml: doctype-public without doctype-system writes no
     declaration (nor does an empty doctype-system) -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output doctype-public="-//P//EN" doctype-system=""/>
  <xsl:template match="/"><root/></xsl:template>
</xsl:stylesheet>
