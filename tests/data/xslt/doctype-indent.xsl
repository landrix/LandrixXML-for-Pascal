<?xml version="1.0" encoding="UTF-8"?>
<!-- doctype-system with indent="yes" and no XML declaration: the
     indentation starts as after an end tag -->
<xsl:stylesheet version="2.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output doctype-system="s.dtd" indent="yes" omit-xml-declaration="yes"/>
  <xsl:template match="/">
    <xsl:comment>c</xsl:comment>
    <root><a>t</a></root>
  </xsl:template>
</xsl:stylesheet>
