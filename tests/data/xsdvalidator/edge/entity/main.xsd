<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="Picture">
    <xs:restriction base="xs:ENTITY">
      <xs:pattern value="p.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="doc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="e" type="xs:ENTITY" default="pic" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="p" type="Picture" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="l" type="xs:ENTITIES" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="u" minOccurs="0" maxOccurs="unbounded">
          <xs:simpleType>
            <xs:union memberTypes="xs:int xs:ENTITY"/>
          </xs:simpleType>
        </xs:element>
        <xs:element name="k" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ENTITY"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="a" type="xs:ENTITY"/>
      <xs:attribute name="d" type="xs:ENTITY" default="nowhere"/>
    </xs:complexType>
    <xs:unique name="q">
      <xs:selector xpath="k"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
