<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Base">
    <xs:sequence>
      <xs:element name="v" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ext">
    <xs:complexContent>
      <xs:extension base="Base">
        <xs:sequence>
          <xs:element name="w" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Res">
    <xs:complexContent>
      <xs:restriction base="Base">
        <xs:sequence>
          <xs:element name="v" type="xs:int"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="TB" block="restriction">
    <xs:sequence>
      <xs:element name="v" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TR">
    <xs:complexContent>
      <xs:restriction base="TB">
        <xs:sequence>
          <xs:element name="v" type="xs:int"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="U">
    <xs:union memberTypes="xs:int xs:date"/>
  </xs:simpleType>

  <xs:element name="shape" type="Base" abstract="true"/>
  <xs:element name="circle" substitutionGroup="shape"/>
  <xs:element name="square" substitutionGroup="shape" type="Ext"/>
  <xs:element name="dot" substitutionGroup="circle" type="Res"/>
  <xs:element name="item" type="xs:decimal"/>
  <xs:element name="price" substitutionGroup="item" type="xs:int"/>
  <xs:element name="blocked" type="Base" block="extension"/>
  <xs:element name="bx" substitutionGroup="blocked" type="Ext"/>
  <xs:element name="br" substitutionGroup="blocked" type="Res"/>
  <xs:element name="nosub" type="xs:string" block="substitution"/>
  <xs:element name="ns1" substitutionGroup="nosub"/>
  <xs:element name="th" type="TB"/>
  <xs:element name="tr" substitutionGroup="th" type="TR"/>
  <xs:element name="uh" type="U"/>
  <xs:element name="um" substitutionGroup="uh" type="xs:short"/>
  <xs:element name="ah" abstract="true"/>

  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="shape" maxOccurs="unbounded"/>
        <xs:element ref="item" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="blocked" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="nosub" minOccurs="0"/>
        <xs:element ref="th" minOccurs="0"/>
        <xs:element ref="uh" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="all" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element ref="item"/>
              <xs:element ref="shape" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
        <xs:element ref="ah" minOccurs="0"/>
        <xs:element name="end" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
