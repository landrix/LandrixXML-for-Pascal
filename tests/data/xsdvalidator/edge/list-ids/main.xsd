<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="idlist"><xs:list itemType="xs:ID"/></xs:simpleType>
  <xs:simpleType name="refOrRefs"><xs:union memberTypes="xs:int xs:IDREFS"/></xs:simpleType>
  <xs:element name="r">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="e" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID"/>
            <xs:attribute name="refs" type="xs:IDREFS"/>
            <xs:attribute name="u" type="refOrRefs"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="g" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:attribute name="ids" type="idlist"/></xs:complexType>
        </xs:element>
        <xs:element name="refs" type="xs:IDREFS" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
