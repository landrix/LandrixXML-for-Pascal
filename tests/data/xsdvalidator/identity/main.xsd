<?xml version="1.0" encoding="UTF-8"?>
<!-- unique, key and keyref with attribute and element fields; unprefixed
     names in selectors have no namespace (selector "nons" selects nothing). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:t" targetNamespace="urn:t" elementFormDefault="qualified">
<xs:element name="r">
  <xs:complexType><xs:sequence>
    <xs:element name="item" maxOccurs="unbounded"><xs:complexType><xs:sequence><xs:element name="code" type="xs:decimal" minOccurs="0"/></xs:sequence>
      <xs:attribute name="id" type="xs:string"/><xs:attribute name="n" type="xs:int"/></xs:complexType></xs:element>
    <xs:element name="ref" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="to" type="xs:string"/></xs:complexType></xs:element>
  </xs:sequence></xs:complexType>
  <xs:key name="k"><xs:selector xpath="t:item"/><xs:field xpath="@id"/></xs:key>
  <xs:unique name="u"><xs:selector xpath="t:item"/><xs:field xpath="t:code"/><xs:field xpath="@n"/></xs:unique>
  <xs:keyref name="kr" refer="t:k"><xs:selector xpath="t:ref"/><xs:field xpath="@to"/></xs:keyref>
  <xs:unique name="any"><xs:selector xpath=".//*"/><xs:field xpath="@n"/></xs:unique>
  <xs:unique name="nons"><xs:selector xpath="item"/><xs:field xpath="@id"/></xs:unique>
</xs:element></xs:schema>
