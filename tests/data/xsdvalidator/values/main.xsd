<xs:element name="r"><xs:complexType><xs:sequence>
  <xs:element name="i" type="xs:int" maxOccurs="unbounded"/>
  <xs:element name="n" type="xs:NCName" maxOccurs="unbounded"/>
  <xs:element name="s" type="xs:string" maxOccurs="unbounded"/>
  <xs:element name="id" type="xs:ID" maxOccurs="unbounded"/>
  <xs:element name="sc" type="SC" maxOccurs="unbounded"/>
  <xs:element name="w"><xs:complexType><xs:attribute name="x" type="xs:int"/><xs:attribute name="idattr" type="xs:ID"/><xs:attribute name="nc" type="xs:NCName"/></xs:complexType></xs:element>
  <xs:element name="w2"><xs:complexType><xs:attribute name="idattr" type="xs:ID"/></xs:complexType></xs:element>
</xs:sequence></xs:complexType></xs:element></xs:schema>
